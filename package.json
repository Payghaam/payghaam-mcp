{
  "name": "@payghaam/mcp-server",
  "version": "0.1.0",
  "description": "MCP server exposing Payghaam journeys and the events they need, so a coding agent can instrument your app.",
  "license": "MIT",
  "author": "Payghaam <dev@payghaam.com>",
  "homepage": "https://github.com/Payghaam/payghaam-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Payghaam/payghaam-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Payghaam/payghaam-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "analytics",
    "engagement",
    "payghaam",
    "coding-agent"
  ],
  "type": "module",
  "bin": {
    "payghaam-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run build && npm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
